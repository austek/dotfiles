{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>austek/renovate-config"],
  "packageRules": [
    { "matchDatasources": ["docker"], "matchPackageNames": ["ubuntu"], "allowedVersions": "/^\\d{2}\\.04$/" },
    { "matchDatasources": ["custom.antigravity-ide"], "minimumReleaseAgeBehaviour": "timestamp-optional" }
  ],
  "customDatasources": {
    "antigravity-ide": {
      "defaultRegistryUrlTemplate": "https://antigravity-ide-auto-updater-974169037036.us-central1.run.app/releases",
      "format": "json",
      "transformTemplates": ["{ \"releases\": $.{ \"version\": version & \"-\" & execution_id } }"]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Installer scripts pinned to a tag in a raw.githubusercontent.com URL",
      "managerFilePatterns": ["/^bin/dotfiles_setup/.+\\.py$/", "/^packages/checksums\\.txt$/"],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/(?<depName>[^/\\s\"]+/[^/\\s\"]+)/(?:refs/tags/)?(?<currentValue>v?\\d[^/\\s\"]*)/"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "GitHub release .debs: version in github_bins.txt and the digest line in checksums.txt",
      "managerFilePatterns": ["/^packages/github_bins\\.txt$/", "/^packages/checksums\\.txt$/"],
      "matchStrings": [
        "^(?<depName>[\\w.-]+/[\\w.-]+) (?<currentValue>\\d[\\w.]*) ",
        "https://github\\.com/(?<depName>[^/\\s]+/[^/\\s]+)/releases/download/v(?<currentValue>\\d[^/\\s]*)/"
      ],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "kind node image used by kdev",
      "managerFilePatterns": ["/^local/\\.local/bin/kdev$/"],
      "matchStrings": ["K8S_VERSION=\"(?<currentValue>v[^\"]+)\""],
      "depNameTemplate": "kindest/node",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "ingress-nginx controller manifest ref defaulted in kdev",
      "managerFilePatterns": ["/^local/\\.local/bin/kdev$/"],
      "matchStrings": ["INGRESS_NGINX_REF:-controller-v(?<currentValue>[\\d.]+)\\}"],
      "depNameTemplate": "kubernetes/ingress-nginx",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^controller-v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Python version passed to setup-uv",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["python-version: '(?<currentValue>[\\d.]+)'"],
      "depNameTemplate": "python",
      "datasourceTemplate": "python-version",
      "versioningTemplate": "python"
    },
    {
      "customType": "regex",
      "description": "Antigravity IDE fallback build, version-executionId",
      "managerFilePatterns": ["/^bin/dotfiles_setup/antigravity\\.py$/"],
      "matchStrings": ["PINNED_BUILD = \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "antigravity-ide",
      "datasourceTemplate": "custom.antigravity-ide",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "auditr pinned for pipx",
      "managerFilePatterns": ["/^bin/dotfiles_setup/post_apt_installers\\.py$/"],
      "matchStrings": ["AUDITR_VERSION = \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "auditr",
      "datasourceTemplate": "pypi"
    }
  ]
}
