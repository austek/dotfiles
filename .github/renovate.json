{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>austek/renovate-config"],
  "packageRules": [
    { "matchDatasources": ["docker"], "matchPackageNames": ["ubuntu"], "allowedVersions": "/^\\d{2}\\.04$/" },
    { "matchDatasources": ["custom.antigravity-ide"], "minimumReleaseAgeBehaviour": "timestamp-optional" },
    { "matchDepNames": ["astral-sh/uv", "uv"], "groupName": "uv" },
    { "matchDepNames": ["aws/aws-cli"], "allowedVersions": "/^2\\./" },
    { "matchFileNames": ["bin/dotfiles_setup/claude_tools.py"], "matchDepNames": ["python"], "allowedVersions": "<3.15" }
  ],
  "customDatasources": {
    "antigravity-ide": {
      "defaultRegistryUrlTemplate": "https://antigravity-ide-auto-updater-974169037036.us-central1.run.app/releases",
      "format": "json",
      "transformTemplates": ["{ \"releases\": $.{ \"version\": version & \"-\" & execution_id } }"]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "uv installer script pinned to a release in an astral.sh URL",
      "managerFilePatterns": ["/^bin/dotfiles_setup/.+\\.py$/", "/^packages/checksums\\.txt$/"],
      "matchStrings": ["https://astral\\.sh/uv/(?<currentValue>\\d[^/\\s\"]*)/install\\.sh"],
      "depNameTemplate": "astral-sh/uv",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Installer scripts pinned to a tag in a raw.githubusercontent.com URL",
      "managerFilePatterns": ["/^bin/dotfiles_setup/.+\\.py$/", "/^packages/checksums\\.txt$/"],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/(?<depName>[^/\\s\"]+/[^/\\s\"]+)/(?:refs/tags/)?(?<currentValue>v?\\d[^/\\s\"]*)/"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "GitHub release .debs: version and filename in github_bins.txt",
      "managerFilePatterns": ["/^packages/github_bins\\.txt$/"],
      "matchStrings": [
        "(?<lead>^|\\n)(?<depName>[\\w.-]+/[\\w.-]+) (?<currentValue>\\d[\\w.]*) (?<file>\\S+)"
      ],
      "autoReplaceStringTemplate": "{{{lead}}}{{{depName}}} {{{newValue}}} {{{replace currentValue newValue file}}}",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "GitHub release .debs: tag and filename in the checksums.txt URL; the digest stays stale until re-recorded",
      "managerFilePatterns": ["/^packages/checksums\\.txt$/"],
      "matchStrings": [
        "(?<digest>[0-9a-f]{64})  https://github\\.com/(?<depName>[^/\\s]+/[^/\\s]+)/releases/download/v(?<currentValue>\\d[^/\\s]*)/(?<file>\\S+\\.deb)"
      ],
      "autoReplaceStringTemplate": "{{{digest}}}  https://github.com/{{{depName}}}/releases/download/v{{{newValue}}}/{{{replace currentValue newValue file}}}",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "lazydocker release: version constant and the checksums.txt URL; the digest stays stale until re-recorded",
      "managerFilePatterns": ["/^packages/release_specs\\.json$/", "/^packages/checksums\\.txt$/"],
      "matchStrings": [
        "\"package\": \"lazydocker\".*?\"version\": \"(?<currentValue>[^\"]+)\"",
        "jesseduffield/lazydocker/releases/download/v(?<currentValue>\\d[^/\\s\"]*)/",
        "lazydocker_(?<currentValue>\\d[^_\\s]*)_Linux"
      ],
      "depNameTemplate": "jesseduffield/lazydocker",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "istioctl release: version constant and the checksums.txt URL; the digest stays stale until re-recorded",
      "managerFilePatterns": ["/^packages/release_specs\\.json$/", "/^packages/checksums\\.txt$/"],
      "matchStrings": [
        "\"package\": \"istioctl\".*?\"version\": \"(?<currentValue>[^\"]+)\"",
        "istio/istio/releases/download/(?<currentValue>\\d[^/\\s\"]*)/",
        "istio-(?<currentValue>\\d[\\d.]*)-linux-amd64"
      ],
      "depNameTemplate": "istio/istio",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "AWS CLI v2: version constant and the checksums.txt URL; the digest stays stale until re-recorded",
      "managerFilePatterns": ["/^packages/release_specs\\.json$/", "/^packages/checksums\\.txt$/"],
      "matchStrings": [
        "\"package\": \"awscli\".*?\"version\": \"(?<currentValue>[^\"]+)\"",
        "awscli-exe-linux-x86_64-(?<currentValue>\\d+\\.\\d+\\.\\d+)\\.zip"
      ],
      "depNameTemplate": "aws/aws-cli",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "GitHub binary releases (zizmor, mcp-grafana): tag argument and the checksums.txt URL; the digest stays stale until re-recorded",
      "managerFilePatterns": ["/^packages/release_specs\\.json$/", "/^packages/checksums\\.txt$/"],
      "matchStrings": [
        "\"version\": \"(?<currentValue>v[^\"]+)\", \"url\": \"https://github\\.com/(?<depName>zizmorcore/zizmor|grafana/mcp-grafana)/",
        "https://github\\.com/(?<depName>zizmorcore/zizmor|grafana/mcp-grafana)/releases/download/(?<currentValue>v[^/\\s]+)/"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "cargo-deny release (tags have no v prefix): version constant and the checksums.txt URL; the digest stays stale until re-recorded",
      "managerFilePatterns": ["/^packages/release_specs\\.json$/", "/^packages/checksums\\.txt$/"],
      "matchStrings": [
        "\"package\": \"cargo-deny\".*?\"version\": \"(?<currentValue>[^\"]+)\"",
        "EmbarkStudios/cargo-deny/releases/download/(?<currentValue>\\d[^/\\s\"]*)/",
        "cargo-deny-(?<currentValue>\\d[\\d.]*)-x86_64"
      ],
      "depNameTemplate": "EmbarkStudios/cargo-deny",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "collibra/chip release: version constant and the checksums.txt URL; the digest stays stale until re-recorded",
      "managerFilePatterns": ["/^packages/release_specs\\.json$/", "/^packages/checksums\\.txt$/"],
      "matchStrings": [
        "\"package\": \"chip\".*?\"version\": \"(?<currentValue>[^\"]+)\"",
        "collibra/chip/releases/download/v(?<currentValue>\\d[^/\\s\"]*)/",
        "chip-(?<currentValue>\\d[\\d.]*)-linux-amd64"
      ],
      "depNameTemplate": "collibra/chip",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "kind CLI release: version constant and the checksums.txt URL; the digest stays stale until re-recorded",
      "managerFilePatterns": ["/^packages/release_specs\\.json$/", "/^packages/checksums\\.txt$/"],
      "matchStrings": [
        "\"package\": \"kind\".*?\"version\": \"(?<currentValue>[^\"]+)\"",
        "kubernetes-sigs/kind/releases/download/(?<currentValue>v\\d[^/\\s\"]*)/"
      ],
      "depNameTemplate": "kubernetes-sigs/kind",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "actionlint release: version constant and the checksums.txt URL; the digest stays stale until re-recorded",
      "managerFilePatterns": ["/^packages/release_specs\\.json$/", "/^packages/checksums\\.txt$/"],
      "matchStrings": [
        "\"package\": \"actionlint\".*?\"version\": \"(?<currentValue>[^\"]+)\"",
        "rhysd/actionlint/releases/download/v(?<currentValue>\\d[^/\\s\"]*)/",
        "actionlint_(?<currentValue>\\d[\\d.]*)_linux"
      ],
      "depNameTemplate": "rhysd/actionlint",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "gitleaks release: version constant and the checksums.txt URL; the digest stays stale until re-recorded",
      "managerFilePatterns": ["/^packages/release_specs\\.json$/", "/^packages/checksums\\.txt$/"],
      "matchStrings": [
        "\"package\": \"gitleaks\".*?\"version\": \"(?<currentValue>[^\"]+)\"",
        "gitleaks/gitleaks/releases/download/v(?<currentValue>\\d[^/\\s\"]*)/",
        "gitleaks_(?<currentValue>\\d[\\d.]*)_linux"
      ],
      "depNameTemplate": "gitleaks/gitleaks",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "yq (mikefarah, v4) release: tag argument and the checksums.txt URL; the digest stays stale until re-recorded",
      "managerFilePatterns": ["/^packages/release_specs\\.json$/", "/^packages/checksums\\.txt$/"],
      "matchStrings": [
        "\"package\": \"yq\".*?\"version\": \"(?<currentValue>[^\"]+)\"",
        "mikefarah/yq/releases/download/(?<currentValue>v\\d[^/\\s\"]*)/"
      ],
      "depNameTemplate": "mikefarah/yq",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "kind node image used by kdev",
      "managerFilePatterns": ["/^local/\\.local/bin/kdev$/"],
      "matchStrings": ["K8S_VERSION=\"(?<currentValue>v[^\"]+)\""],
      "depNameTemplate": "kindest/node",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "ingress-nginx controller manifest ref defaulted in kdev",
      "managerFilePatterns": ["/^local/\\.local/bin/kdev$/"],
      "matchStrings": ["INGRESS_NGINX_REF:-controller-v(?<currentValue>[\\d.]+)\\}"],
      "depNameTemplate": "kubernetes/ingress-nginx",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^controller-v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Python version passed to setup-uv",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["python-version: '(?<currentValue>[\\d.]+)'"],
      "depNameTemplate": "python",
      "datasourceTemplate": "python-version",
      "versioningTemplate": "python"
    },
    {
      "customType": "regex",
      "description": "Python version SonarQube analyses the code as",
      "managerFilePatterns": ["/^sonar-project\\.properties$/"],
      "matchStrings": ["sonar\\.python\\.version=(?<currentValue>\\d+\\.\\d+)"],
      "depNameTemplate": "python",
      "datasourceTemplate": "python-version",
      "versioningTemplate": "python"
    },
    {
      "customType": "regex",
      "description": "Antigravity IDE pinned build, version-executionId; its checksums.txt URL and digest need a manual follow-up",
      "managerFilePatterns": ["/^bin/dotfiles_setup/antigravity\\.py$/"],
      "matchStrings": ["PINNED_BUILD = \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "antigravity-ide",
      "datasourceTemplate": "custom.antigravity-ide",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "auditr pinned for pipx",
      "managerFilePatterns": ["/^bin/dotfiles_setup/post_apt_installers\\.py$/"],
      "matchStrings": ["AUDITR_VERSION = \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "auditr",
      "datasourceTemplate": "pypi"
    }
  ]
}
