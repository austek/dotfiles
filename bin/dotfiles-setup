#!/usr/bin/env python3
"""Entry point for dotfiles-setup. Resolves its own real path (following
the ~/bin -> repo/bin stow symlink) so sibling modules import correctly
regardless of how this file was invoked."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from dotfiles_setup.cli import main

if __name__ == "__main__":
    sys.exit(main())
