#!/usr/bin/env bash
# Runs a command as a tmux pane's process, then waits CLAUDE_TMUX_GRACE seconds for Cozempic's typed
# `cd '<dir>' && claude … --resume <id>` line. Enter, Ctrl-D or the timeout ends the pane; other input exits 64.
# Usage: claude-pane-loop <command> [args...]

grace=${CLAUDE_TMUX_GRACE:-60}
q="'"
dq='"'
esc_posix="${q}${dq}${q}${dq}${q}"
esc_helper="${q}\\${q}${q}"
safe='[A-Za-z0-9_./:=@%+,-]'
resume_re="^cd ${q}(([^${q}]|${q}\\\\${q}${q})*)${q} && claude( .*)?\$"
quoted_re="^ ${q}(([^${q}]|${esc_posix}|${q}\\\\${q}${q})*)${q}( .*)?\$"
bare_re="^ (${safe}+)( .*)?\$"
flag_re="^--[A-Za-z][A-Za-z0-9-]*(=${safe}+)?\$"
short_re='^-[A-Za-z]$'

# Sets token, rest and quoted from the front of $1; a quoted token is decoded as literal data.
read_token() {
    if [[ $1 =~ $quoted_re ]]; then
        token=${BASH_REMATCH[1]//"$esc_posix"/$q}
        token=${token//"$esc_helper"/$q}
        rest=${BASH_REMATCH[3]}
        quoted=1
    elif [[ $1 =~ $bare_re ]]; then
        token=${BASH_REMATCH[1]}
        rest=${BASH_REMATCH[2]}
        quoted=0
    else
        return 1
    fi
}

# Requires exactly one --resume, as the last flag, with at most a hex session id after it.
ends_with_resume() {
    local n=${#argv[@]} count=0 arg
    for arg in "${argv[@]}"; do
        [[ $arg == --resume ]] && count=$((count + 1))
    done
    (( count == 1 )) || return 1
    [[ ${argv[n-1]} == --resume ]] && return 0
    [[ ${argv[n-2]} == --resume && ${argv[n-1]} =~ ^[0-9a-f-]+$ ]]
}

parse_args() {
    local rest=$1 token quoted
    argv=()
    while [[ -n $rest ]]; do
        read_token "$rest" || { reject_reason="malformed or unsafe argument"; return 1; }
        if [[ $quoted == 0 && $token == -* ]]; then
            [[ $token =~ $flag_re || $token =~ $short_re ]] || { reject_reason="invalid flag"; return 1; }
        fi
        argv+=("$token")
    done
    ends_with_resume || { reject_reason="needs exactly one trailing --resume [id]"; return 1; }
}

# Sets `dir` and `argv` from a typed resume line; fails on anything but the exact Cozempic shape.
parse_resume_line() {
    [[ $1 =~ $resume_re ]] || { reject_reason="not cd '<dir>' && claude …"; return 1; }
    dir=${BASH_REMATCH[1]//"$esc_helper"/$q}
    local rest=${BASH_REMATCH[3]}
    [[ $dir == /* && -d $dir ]] || { reject_reason="directory is not an existing absolute path"; return 1; }
    parse_args "$rest"
}

reject_line() {
    printf 'claude-pane-loop: resume line rejected (%s): %q\n' "$reject_reason" "$1" >&2
    sleep "${CLAUDE_TMUX_REJECT_PAUSE:-3}"
    exit 64
}

# A leading `env NAME=value` (claude-burst) applies to resumed claude too, which Cozempic types bare.
if [[ $1 == env ]]; then
    for assignment in "${@:2}"; do
        [[ $assignment =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || break
        export "${assignment?}"
    done
fi

"$@"
status=$?
[[ -t 0 ]] || exit "$status"

while true; do
    printf 'claude exited; waiting %ss for a resume. Enter closes now.\n' "$grace"
    IFS= read -r -t "$grace" line || exit "$status"
    [[ -n $line ]] || exit "$status"
    parse_resume_line "$line" || reject_line "$line"
    ( cd -- "$dir" && claude "${argv[@]}" )
    status=$?
done
