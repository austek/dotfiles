#!/usr/bin/env bash
# Runs a command as a tmux pane's process and, once it exits, keeps the pane for CLAUDE_TMUX_GRACE
# seconds so Cozempic's typed `cd <dir> && claude … --resume <id>` line can restart claude in place.
# Enter, Ctrl-D, any other input or the timeout ends the pane (and with it the tmux session).
# Usage: claude-pane-loop <command> [args...]

grace=${CLAUDE_TMUX_GRACE:-60}
resume_line="^cd [^;|&\`\$<>]+ && claude( [^;|&\`\$<>]*)?\$"

"$@"
status=$?
[[ -t 0 ]] || exit "$status"

while true; do
    printf 'claude exited; waiting %ss for a resume. Enter closes now.\n' "$grace"
    IFS= read -r -t "$grace" line || exit "$status"
    [[ $line =~ $resume_line ]] || exit "$status"
    eval "$line"
    status=$?
done
