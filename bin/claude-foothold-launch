#!/bin/sh
# Runs inside the foothold tmux pane. A pre-existing tmux server hands new sessions its own
# environment, so the unit's EnvironmentFile never reaches claude; load the secrets here instead.
set -eu

secrets="$HOME/.config/dotfiles/secrets.env"

# Parses KEY=value lines as data, like systemd's EnvironmentFile: values are never evaluated.
export_assignment() {
    case $1 in *=*) ;; *) return 0 ;; esac
    key=${1%%=*}
    value=${1#*=}
    case $key in '' | *[!A-Za-z0-9_]* | [0-9]*) return 0 ;; esac
    value=${value#"${value%%[![:space:]]*}"}
    value=${value%"${value##*[![:space:]]}"}
    case $value in
        \"*\") value=${value#\"}; value=${value%\"} ;;
        \'*\') value=${value#\'}; value=${value%\'} ;;
    esac
    export "$key=$value"
}

if [ -r "$secrets" ] && case $(stat -L -c %a "$secrets") in *00) true ;; *) false ;; esac; then
    while IFS= read -r line || [ -n "$line" ]; do
        case $line in '' | '#'* | ';'*) continue ;; esac
        export_assignment "$line"
    done < "$secrets"
fi

# Hooks run `node`, which nvm installs under a versioned directory the unit's PATH cannot name.
nvm_node=$(find "$HOME/.nvm/versions/node" -mindepth 2 -maxdepth 2 -name bin -type d 2>/dev/null | sort -V | tail -n 1)
[ -z "$nvm_node" ] || export PATH="$nvm_node:$PATH"

exec "$(dirname -- "$0")/claude-pane-loop" claude --remote-control "$1" --settings "$2"
