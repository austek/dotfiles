#!/usr/bin/env bash
# Manual Cozempic reload for a claude-pane-loop tmux pane. `cozempic reload` resumes by opening gnome-terminal
# or xterm in a new window, never in the pane. This runs the prune with no-op copies of both first on PATH, so
# no window opens, then types the resume line that claude-pane-loop accepts once Claude exits.
# Usage: claude-reload [extra cozempic reload args, default: -rx standard]
set -euo pipefail

[[ -n ${TMUX_PANE:-} ]] || { echo "claude-reload: run inside a tmux pane" >&2; exit 1; }

shims=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/claude-reload-shims
[[ -x $shims/gnome-terminal && -x $shims/xterm ]] || { echo "claude-reload: $shims is missing, so cozempic would open a terminal window" >&2; exit 1; }

config_dir=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
dir=$PWD

pane_pid=$(tmux display-message -p -t "$TMUX_PANE" '#{pane_pid}')
claude_pid=$(pgrep -P "$pane_pid" -f claude | head -n 1 || true)
[[ -n $claude_pid ]] || { echo "claude-reload: no claude process under pane $TMUX_PANE" >&2; exit 1; }

# Claude keeps its live session's `.../<session id>/tasks` directory open; the pid file's sessionId stays at the
# pre-/clear value, so the open directory is the only trusted source and a missing one stops the reload.
live_session_id() {
    local fd target
    for fd in "/proc/$1"/fd/*; do
        target=$(readlink "$fd" 2>/dev/null || true)
        [[ $target =~ /([0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12})/tasks$ ]] && { echo "${BASH_REMATCH[1]}"; return 0; }
    done
    return 1
}

# Prints the ` --remote-control '<name>'` the running claude was started with, in the form claude-pane-loop parses.
remote_control_flag() {
    local -a args
    local i value=""
    mapfile -d '' -t args < "/proc/$1/cmdline"
    for ((i = 1; i < ${#args[@]}; i++)); do
        case ${args[i]} in
            --remote-control) printf ' --remote-control'; value=${args[i+1]:-} ;;
            --remote-control=*) printf ' --remote-control'; value=${args[i]#*=} ;;
            *) continue ;;
        esac
        [[ -z $value || $value == -* ]] || printf " '%s'" "${value//\'/\'\\\'\'}"
        return 0
    done
}

pid_file="$config_dir/sessions/$claude_pid.json"
[[ -r $pid_file ]] || { echo "claude-reload: $pid_file not found" >&2; exit 1; }
session_id=$(jq -er .sessionId "$pid_file")
dir=$(jq -er .cwd "$pid_file")

live_id=$(live_session_id "$claude_pid") || {
    echo "claude-reload: claude $claude_pid holds no session tasks directory open; $pid_file names $session_id, which /clear leaves stale" >&2
    exit 1
}
if [[ $live_id != "$session_id" ]]; then
    echo "claude-reload: $pid_file names $session_id but claude has $live_id open; using $live_id" >&2
    session_id=$live_id
fi

[[ -d $dir ]] || { echo "claude-reload: session directory $dir no longer exists; claude-pane-loop would reject the resume" >&2; exit 1; }

args=("$@")
(( ${#args[@]} )) || args=(-rx standard)

resume_line="cd '${dir//\'/\'\\\'\'}' && claude$(remote_control_flag "$claude_pid") --resume $session_id"
buffer="claude-reload-$claude_pid-$$"
# The line travels in a tmux buffer, so the watcher shell below never sees the directory.
tmux set-buffer -b "$buffer" -- "$resume_line"

status=0
PATH="$shims:$PATH" cozempic reload --session "$session_id" "${args[@]}" || status=$?
if (( status != 0 )); then
    tmux delete-buffer -b "$buffer" 2>/dev/null || true
    exit "$status"
fi

# Started only after the reload saved the pruned transcript. Runs under the tmux server, outside the pane's
# systemd scope, so it outlives the pane process tree.
tmux run-shell -b "while kill -0 $claude_pid 2>/dev/null; do sleep 1; done; sleep 2; tmux paste-buffer -d -b $buffer -t $TMUX_PANE && tmux send-keys -t $TMUX_PANE Enter"
