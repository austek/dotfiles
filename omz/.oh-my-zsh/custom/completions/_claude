#compdef claude

# Completes the claude function's own flags (accounts from ~/.claude-*, --with names from _claude_with_names);
# Claude Code's options come from its --help via _gnu_generic.
function _claude {
    local -a accounts=(main) names=(${(f)"$(_claude_with_names)"})
    local dir
    for dir in ~/.claude-*(N/); do
        accounts+=(${dir:t:s/.claude-/})
    done

    case $words[CURRENT-1] in
        --account) compadd -a accounts; return ;;
        --with) compadd -a names; return ;;
    esac
    if compset -P '--account='; then
        compadd -a accounts
        return
    fi
    if compset -P '--with='; then
        compset -P '*,'
        compadd -a names
        return
    fi

    [[ $PREFIX == -* ]] && compadd -- --account= --burst --with=
    _gnu_generic
}
