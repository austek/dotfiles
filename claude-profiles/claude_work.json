{
  "enabledPlugins": {
    "atlassian@claude-plugins-official": true,
    "jdtls-lsp@claude-plugins-official": true,
    "kotlin-lsp@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "sonarqube@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/sonar-secrets/build-scripts/pretool-secrets.sh\"",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/sonar-secrets/build-scripts/prompt-secrets.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
