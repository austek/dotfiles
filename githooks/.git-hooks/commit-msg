#!/usr/bin/env bash
# Global commit-msg hook. Pure passthrough to the repo's own local
# .git/hooks/commit-msg if one exists (e.g. Jira-ticket-in-message checks) —
# core.hooksPath being global must not silently disable it.
set -euo pipefail

git_dir=$(git rev-parse --git-dir)
local_hook="$git_dir/hooks/commit-msg"
if [[ -f "$local_hook" && -x "$local_hook" ]]; then
    exec "$local_hook" "$@"
fi
