#!/usr/bin/env bash
# Global commit-msg hook. Strips AI-attribution trailers that tooling may
# inject, then passes through to the repo's own local .git/hooks/commit-msg
# if one exists (e.g. Jira-ticket-in-message checks) — core.hooksPath being
# global must not silently disable it.
set -euo pipefail

msg_file="$1"
sed -i.bak \
    -e '/^Co-Authored-By:.*\(Claude\|Anthropic\)/Id' \
    -e '/^Claude-Session:/d' \
    -e '/^🤖 Generated with \[Claude Code\]/d' \
    "$msg_file"
rm -f "$msg_file.bak"

local_hook=$(git rev-parse --git-path hooks/commit-msg)
if [[ -f "$local_hook" && -x "$local_hook" ]]; then
    exec "$local_hook" "$@"
fi
