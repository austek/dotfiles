#!/usr/bin/env bash
# Chains to the local .git/hooks/pre-commit first (still on disk, just not
# invoked directly once core.hooksPath is global). Reads the index via
# `git show`, not the working tree, so partial `git add -p` staging is safe.
set -euo pipefail

local_hook="$(git rev-parse --path-format=absolute --git-common-dir)/hooks/pre-commit"
if [[ -f "$local_hook" && -x "$local_hook" ]]; then
    "$local_hook" "$@"
fi

# A marker fully wrapped in backticks documents the rule and is not a leftover note.
marker='CLAUDENOTE'
documented="\`${marker}:\`"

found=0
while IFS= read -r -d '' file; do
    [[ -f "$file" ]] || continue
    hits=$(git show ":$file" 2>/dev/null | sed "s/${documented}//g" | grep -cF "${marker}:" || true)
    if [[ "${hits:-0}" -gt 0 ]]; then
        echo "pre-commit: $file has a leftover ${marker}: marker — resolve or remove it before committing." >&2
        found=1
    fi
done < <(git diff --cached --name-only --diff-filter=ACM -z)

if [[ "$found" -eq 1 ]]; then
    exit 1
fi
