# ssh uses the first value found, so order is precedence: hardened.conf's crypto
# policy first, then local.conf for machine-local overrides, then config.d's
# per-host segments, then the Host * defaults below.
Include ~/.ssh/config.d/hardened.conf
Include ~/.ssh/local.conf
Include ~/.ssh/config.d/*.conf

Host *
    User git
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
