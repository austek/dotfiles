# Load order matters: hardened.conf's crypto policy first (global override),
# then config.d's per-host segments, then local.conf last for temporary,
# machine-local overrides.
Include ~/.ssh/config.d/hardened.conf
Include ~/.ssh/config.d/*.conf
Include ~/.ssh/local.conf

Host *
    User git
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
