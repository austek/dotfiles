# Usage: chandoff [optional note]
# Prompts Claude to write a timestamped handoff summary under ~/.claude/scratches/, then hints running /clear

chandoff() {
  local note="${1:-Task checkpoint}"
  echo "Generating session handoff summary..."
  if ! claude -p --continue "Summarize our current session into a high-density 5-bullet handoff note: 1. Core objective, 2. What was completed, 3. Unresolved issues/bugs, 4. Modified files, 5. Immediate next step. Note from the user: ${note}. Save it to \$HOME/.claude/scratches/handoff_${TIMESTAMP:-$(date +%Y%m%d_%H%M%S)}.md."; then
    echo "chandoff: claude failed, no handoff saved." >&2
    return 1
  fi
  echo ""
  echo "Handoff saved! Run '/clear' to reset context, then resume with your saved handoff note."
}
