# Downloads the specific SSH key for this hostname from Bitwarden
# Usage: secrets_hydrate

if ! command -v jq &> /dev/null; then
    echo "⚠️  Error: 'jq' is required (sudo apt install jq)."
    return 1
fi

bw_unlock || return 1

local current_host
current_host=$(hostname)
local bw_item_name="ssh-key-${current_host}"
local target_key="$HOME/.ssh/id_ed25519"
local pub_key="${target_key}.pub"

echo "🔍 Managing secrets for host: ${current_host}"

if [[ -f "$target_key" ]]; then
    echo "✅ SSH Key already exists locally."
    return 0
fi

echo "☁️  Fetching item '${bw_item_name}'..."

local private_key
private_key=$(bw get item "$bw_item_name" --session "$BW_SESSION" 2>/dev/null | jq -r '.sshKey.privateKey // empty')

if [[ -z "$private_key" || "$private_key" == "null" ]]; then
    echo "❌ Error: Key '${bw_item_name}' not found in Bitwarden or has no Private Key attached."
return 1
fi

mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh"
touch "$target_key"
chmod 600 "$target_key"
echo "$private_key" > "$target_key"

echo "🔑 Deriving Public Key..."
if ssh-keygen -y -f "$target_key" > "$pub_key"; then
    chmod 644 "$pub_key"
    echo "✅ Key installed successfully."
    ssh-add "$target_key" 2>/dev/null
else
    echo "❌ Error: Invalid key extracted."
        rm "$target_key" "$pub_key" 2>/dev/null
    return 1
fi
