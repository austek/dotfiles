# Splits claude's own flags from the arguments meant for Claude Code. Sets accounts, with_names, with_bare and rest in the caller's scope; everything from a literal -- on goes to rest untouched.
# Usage: _claude_parse_args <args...>
_claude_parse_args() {
  while (( $# )); do
    case $1 in
      --) rest+=("$@"); return ;;
      --burst) accounts+=(burst) ;;
      # An empty `--account=` or `--with=` takes the next word, but never a literal `--`, and for `--with` never a word starting with `-`.
      --account|--account=*)
        local name=${${1#--account}#=}
        if [[ -z $name ]] && (( $# > 1 )) && [[ $2 != -- ]]; then name=$2; shift; fi
        [[ -n $name ]] || { print -ru2 -- "claude: --account needs a name"; return 2 }
        accounts+=($name) ;;
      --with|--with=*)
        local val=${${1#--with}#=}
        if [[ -z $val ]] && (( $# > 1 )) && [[ $2 != -* ]]; then val=$2; shift; fi
        if [[ -n $val ]]; then with_names+=(${(s:,:)val}); elif [[ $1 == --with ]]; then with_bare=1; fi ;;
      *) rest+=("$1") ;;
    esac
    shift
  done
}
