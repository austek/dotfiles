# Splits claude's own flags from the arguments meant for Claude Code. Sets accounts, with_names, with_bare and rest in the caller's scope; everything from a literal -- on goes to rest untouched.
# Usage: _claude_parse_args <args...>
_claude_parse_args() {
  while (( $# )); do
    case $1 in
      --) rest+=("$@"); return ;;
      --burst) accounts+=(burst) ;;
      --account=*) [[ -n ${1#--account=} ]] || { print -ru2 -- "claude: --account needs a name"; return 2 }; accounts+=(${1#--account=}) ;;
      --account) (( $# > 1 )) && [[ -n $2 ]] || { print -ru2 -- "claude: --account needs a name"; return 2 }; accounts+=($2); shift ;;
      --with=*) with_names+=(${(s:,:)${1#--with=}}) ;;
      --with) if (( $# > 1 )) && [[ $2 != -* ]]; then with_names+=(${(s:,:)2}); shift; else with_bare=1; fi ;;
      *) rest+=("$1") ;;
    esac
    shift
  done
}
