# Runs a claude command in a tmux session named claude-<label>-<dir>-<path hash> so it survives closing
# the terminal. Runs it directly when already in tmux, without a TTY, for -p/--print, or without tmux.
# Usage: claude-tmux <label> <command> [args...]
claude-tmux() {
  local label=$1
  shift
  if [[ -n $TMUX || ! -t 0 || ! -t 1 ]] || (( ! $+commands[tmux] )) || (( ${+argv[(r)(-p|--print)]} )); then
    "$@"
    return
  fi
  local dir_hash=${"$(print -rn -- "$PWD" | cksum)"%% *}
  # An already-running tmux server hands new sessions its own environment, not the caller's.
  local -a env_args=()
  local name
  for name in ${(k)parameters[(R)scalar*export*]}; do
    [[ $name == (TMUX|TMUX_PANE|_) ]] || env_args+=(-e "$name=${(P)name}")
  done
  tmux new-session -A -s "claude-${label//[.:]/_}-${${PWD:t}//[.:]/_}-${dir_hash}" "${env_args[@]}" -- "$@"
}
