# Connects to a GCP instance through IAP with agent forwarding
# Usage: ssg <instance>   (e.g. ssg dev, ssg dgc-dev)
# .zshrc unloads it when gcloud is not on PATH.

if [[ -z "$1" ]]; then
    echo "Usage: ssg <instance>" >&2
    return 2
fi

echo "Connecting to GCP instance: $1"
gcloud compute ssh --tunnel-through-iap --ssh-flag="-A" "$1"
