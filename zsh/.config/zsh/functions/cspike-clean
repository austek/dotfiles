# Clean up worktree when done
# Usage: cspike-clean spike-name
cspike-clean() {
  if [[ -z "$1" ]]; then
    echo "Usage: cspike-clean <spike-branch-name>" >&2
    return 1
  fi

  local name="$1"
  local target_dir="$HOME/.claude/scratches/spikes/spike-${name}"

  if ! git worktree remove "$target_dir" --force; then
    echo "cspike-clean: failed to remove worktree '$target_dir'; leaving branch '$name' in place." >&2
    return 1
  fi
  if ! git branch -D "$name"; then
    echo "cspike-clean: worktree removed, but failed to delete branch '$name'." >&2
    return 1
  fi
  echo -e "\033[1;32mWorktree and spike branch '$name' deleted.\033[0m"
}
