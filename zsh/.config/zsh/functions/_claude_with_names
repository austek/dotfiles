# Prints the --with entry names, one per line: the built-in ones from _claude_with's source plus every restore_argv_<id> the ~/.config/zsh/claude-with.d extensions define when sourced (so dynamic entries count).
_claude_with_names() {
  local -a sources=(${^fpath}/_claude_with(N.[1]))
  local -aU names=()
  local line
  for line in ${(f)"$(cat -- $sources 2>/dev/null)"}; do
    [[ $line =~ 'local -a restore_argv_([A-Za-z0-9_]+)=' ]] && names+=(${match[1]//_/-})
  done
  names+=(${${(f)"$(_claude_with_extension_ids 2>/dev/null)"}//_/-})
  print -rl -- $names
}
