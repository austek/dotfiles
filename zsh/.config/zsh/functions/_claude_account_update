# Changes an account's manifest. main has a manifest too, so its telemetry and labels can change.
# Usage: _claude_account_update <name> <option>...
_claude_account_update() {
  local name=${1:-} filter=.
  (( $# )) && shift
  local -a jqargs=()
  [[ $name == main || -d $HOME/.claude-$name ]] || { print -ru2 -- "claude-account: account '$name' does not exist; create it with: claude-account create $name"; return 1 }
  (( $# )) || { print -ru2 -- "claude-account: nothing to update; give an option (see claude-account usage in the function header)"; return 2 }
  _claude_account_opts "$@" || return
  _claude_account_edit $name $filter "${jqargs[@]}"
}
