#compdef dotfiles-setup

local -a commands presets
commands=(
  'install:install packages and dotfiles for a machine profile'
  'private:manage the optional private overlay repo'
)
presets=( ${${(f)"$(print -l -- $HOME/.dotfiles/presets/*.json(N:t:r))"}:-work personal homelab} )

_arguments -C \
  '(-h --help)'{-h,--help}'[show help message]' \
  '1: :->command' \
  '*::arg:->args'

case $state in
  command)
    _describe 'command' commands
    ;;
  args)
    case ${words[1]} in
      install)
        _arguments \
          '--preset[machine profile to set up]:preset:($presets)' \
          '--dry-run[show what would be done without executing commands]' \
          '(-v --verbose)'{-v,--verbose}'[show step-by-step progress]' \
          '-vv[also show raw output from apt/stow/dpkg/etc]' \
          '-vvv[full debug: also enable command tracing]' \
          '--reconfigure[re-prompt for git identity even if already configured]' \
          '--force[back up files that block stow and stow anyway]' \
          '--accept-drift[overwrite settings.json even if edited since last install]' \
          '(--no-system)--system[always run the sudo steps]' \
          '(--system)--no-system[skip the sudo steps]' \
          '(-h --help)'{-h,--help}'[show help message]'
        ;;
      private)
        if (( CURRENT == 2 )); then
          _values 'private-command' 'clone[clone your private overlay repo]'
        else
          _arguments \
            '--repo[git URL of your private overlay repo]:url:' \
            '--dest[clone destination]:path:_files -/' \
            '--dry-run[show what would be done without executing commands]' \
            '(-v --verbose)'{-v,--verbose}'[confirm what was cloned and where]' \
            '(-h --help)'{-h,--help}'[show help message]'
        fi
        ;;
    esac
    ;;
esac
