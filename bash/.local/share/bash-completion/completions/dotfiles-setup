_dotfiles_setup_presets() {
    local file names=""
    for file in "$HOME"/.dotfiles/presets/*.json; do
        [[ -e "$file" ]] && names+="$(basename "$file" .json) "
    done
    echo "${names:-work personal homelab}"
}

_dotfiles_setup_completions() {
    local cur prev
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD - 1]}"
    [[ "$prev" == "=" ]] && prev="${COMP_WORDS[COMP_CWORD - 2]}"
    [[ "$cur" == "=" ]] && cur=""

    case "${COMP_WORDS[1]}" in
        install)
            if [[ "$prev" == "--preset" ]]; then
                COMPREPLY=($(compgen -W "$(_dotfiles_setup_presets)" -- "$cur"))
            elif [[ "$cur" == --preset=* ]]; then
                COMPREPLY=($(compgen -P "--preset=" -W "$(_dotfiles_setup_presets)" -- "${cur#--preset=}"))
            else
                local flags="--preset --dry-run -v --verbose -vv -vvv --reconfigure --force --accept-drift -h --help"
                [[ " ${COMP_WORDS[*]} " != *" --no-system "* ]] && flags+=" --system"
                [[ " ${COMP_WORDS[*]} " != *" --system "* ]] && flags+=" --no-system"
                COMPREPLY=($(compgen -W "$flags" -- "$cur"))
            fi
            ;;
        private)
            if [[ "${COMP_WORDS[2]}" == "clone" ]]; then
                if [[ "$prev" == "--dest" ]]; then
                    COMPREPLY=($(compgen -d -- "$cur"))
                else
                    COMPREPLY=($(compgen -W "--repo --dest --dry-run -v --verbose -h --help" -- "$cur"))
                fi
            else
                COMPREPLY=($(compgen -W "clone -h --help" -- "$cur"))
            fi
            ;;
        *)
            COMPREPLY=($(compgen -W "install private -h --help" -- "$cur"))
            ;;
    esac
}
complete -F _dotfiles_setup_completions dotfiles-setup
