_dfctl_presets() {
    local file names=""
    for file in "$HOME"/.dotfiles/presets/*.json; do
        [[ -e "$file" ]] && names+="$(basename "$file" .json) "
    done
    echo "${names:-work personal homelab}"
}

_dfctl_install_flags() {
    local flags="--preset --dry-run -v --verbose -vv -vvv --reconfigure --force --accept-drift --upgrade --prune -y --yes -h --help"
    local word system=1 no_system=1
    for word in "${COMP_WORDS[@]}"; do
        [[ "$word" == "--system" ]] && no_system=0
        [[ "$word" == "--no-system" ]] && system=0
    done
    (( system )) && flags+=" --system"
    (( no_system )) && flags+=" --no-system"
    echo "$flags"
}

_dfctl_completions() {
    local cur prev
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD - 1]}"
    [[ "$prev" == "=" ]] && prev="${COMP_WORDS[COMP_CWORD - 2]}"
    [[ "$cur" == "=" ]] && cur=""

    case "${COMP_WORDS[1]}" in
        apply|install)
            if [[ "$prev" == "--preset" ]]; then
                COMPREPLY=($(compgen -W "$(_dfctl_presets)" -- "$cur"))
            elif [[ "$cur" == --preset=* ]]; then
                COMPREPLY=($(compgen -P "--preset=" -W "$(_dfctl_presets)" -- "${cur#--preset=}"))
            else
                COMPREPLY=($(compgen -W "$(_dfctl_install_flags)" -- "$cur"))
            fi
            ;;
        propose)
            COMPREPLY=($(compgen -W "-h --help" -- "$cur"))
            ;;
        doctor)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--list-checks --json --dry-run -v --verbose -vv -vvv -y --yes -h --help" -- "$cur"))
            else
                COMPREPLY=($(compgen -W "fix $(dfctl doctor --list-checks 2>/dev/null)" -- "$cur"))
            fi
            ;;
        overlay)
            if [[ "${COMP_WORDS[2]}" == "clone" ]]; then
                if [[ "$prev" == "--dest" ]]; then
                    COMPREPLY=($(compgen -d -- "$cur"))
                else
                    COMPREPLY=($(compgen -W "--repo --dest --dry-run -v --verbose -h --help" -- "$cur"))
                fi
            else
                COMPREPLY=($(compgen -W "clone -h --help" -- "$cur"))
            fi
            ;;
        foothold)
            if [[ "${COMP_WORDS[2]}" == "restart" ]]; then
                COMPREPLY=($(compgen -W "--dry-run -v --verbose -h --help" -- "$cur"))
            else
                COMPREPLY=($(compgen -W "restart -h --help" -- "$cur"))
            fi
            ;;
        *)
            COMPREPLY=($(compgen -W "apply propose doctor overlay foothold -h --help" -- "$cur"))
            ;;
    esac
}
complete -F _dfctl_completions dfctl
