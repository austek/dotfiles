{
  "env": {
    "COZEMPIC_NO_AUTO_UPDATE": "1",
    "COZEMPIC_NO_GLOBAL_INIT": "1",
    "PATH": "$HOME/.nvm/current/bin:$HOME/.local/bin:$HOME/.sdkman/candidates/java/current/bin:$HOME/.cargo/bin:$HOME/.local/share/sonarqube-cli/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games"
  },
  "permissions": {
    "additionalDirectories": [
      "/tmp",
      "~/Workspace"
    ],
    "allow": [
      "Bash(awk *)",
      "Bash(cat *)",
      "Bash(cd *)",
      "Bash(command *)",
      "Bash(cp *)",
      "Bash(docker info)",
      "Bash(docker manifest inspect *)",
      "Bash(gh *)",
      "Bash(git *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(jobs *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(mkdocs --version)",
      "Bash(mv *)",
      "Bash(mvn *)",
      "Bash(pip* *)",
      "Bash(pytest *)",
      "Bash(python* *)",
      "Bash(rg *)",
      "Bash(rtk *)",
      "Bash(shellcheck *)",
      "Bash(sleep *)",
      "Bash(sonar *)",
      "Bash(sonar-scanner *)",
      "Bash(tail *)",
      "Bash(tmux capture-pane *)",
      "Bash(tmux list-sessions *)",
      "Bash(tmux ls *)",
      "Bash(touch *)",
      "Bash(uv *)",
      "Bash(which *)",
      "Edit",
      "Glob",
      "Grep",
      "Read",
      "mcp__claude-in-chrome__*",
      "mcp__idea__*",
      "mcp__serena__*",
      "mcp__sonarqube__*"
    ],
    "ask": [
      "Bash(rg *--pre*)"
    ],
    "deny": [
      "Bash(gh repo delete*)",
      "Bash(git push * main*)",
      "Bash(git push * master*)",
      "Bash(git push *:main*)",
      "Bash(git push *:master*)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push *refs/heads/master*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~/*)",
      "Bash(rtk git push * main*)",
      "Bash(rtk git push * master*)",
      "Bash(rtk git push *:main*)",
      "Bash(rtk git push *:master*)",
      "Bash(rtk git push *refs/heads/main*)",
      "Bash(rtk git push *refs/heads/master*)"
    ],
    "defaultMode": "auto"
  },
  "autoMode": {
    "environment": [
      "$defaults",
      "Organization: personal projects under the austek GitHub account, plus the ZirekHQ, hominux and ebbwise GitHub orgs, which I maintain",
      "Primary use of Claude Code: software development — dotfiles, NVDA/TTS tooling (ZirekHQ), the Java library under hominux, and health-tracking apps (ebbwise)",
      "Source control: github.com/austek (personal), github.com/ZirekHQ, github.com/hominux, github.com/ebbwise — every repo under these four namespaces is mine to push to and open PRs against",
      "Repository visibility: repos under ZirekHQ and hominux are public OSS; treat pushes there as publishing and only include that repo's own work. Repos under ebbwise are private and may handle health data: never copy their content into public repos, issues or PRs"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/block-dangerous-rm.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/allow-compound-bash.py\""
          },
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "mcp__idea__execute_terminal_command|mcp__idea__execute_tool|mcp__idea__execute_run_configuration",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/block-dangerous-rm.py\""
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "serena-hooks remind 2>/dev/null || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "serena-hooks activate 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/term-notify\" 'Claude Code: finished' 2>/dev/null || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "MSG=$(cat | PYTHONIOENCODING=utf-8 python3 -c \"import sys,json; print(json.load(sys.stdin).get('message','Claude Code needs attention'))\" 2>/dev/null); \"$HOME/.local/bin/term-notify\" \"${MSG:-Claude Code needs attention}\" 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline-command.sh\""
  },
  "enabledPlugins": {
    "code-modernization@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "receipts@claude-plugins-official": true,
    "cozempic@cozempic": true,
    "metaskills@wondelai-skills": true,
    "code-craftsmanship@wondelai-skills": true,
    "language-personas@ustekai-skills": true,
    "pr-workflow-oss@ustekai-skills": true,
    "babysit-pane@ustekai-skills": true,
    "architecture@ustekai-skills": true,
    "productivity@ustekai-skills": true,
    "dev-utilities@ustekai-skills": true
  },
  "extraKnownMarketplaces": {
    "cozempic": {
      "source": {
        "source": "github",
        "repo": "Ruya-AI/cozempic"
      }
    },
    "wondelai-skills": {
      "source": {
        "source": "github",
        "repo": "wondelai/skills"
      }
    },
    "ustekai-skills": {
      "source": {
        "source": "github",
        "repo": "austek/ustekai-skills"
      }
    }
  },
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true,
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true
}
